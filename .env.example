# Copiar como .env y cambiar los valores. El archivo .env no se sube al repositorio.
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
# Token para consultar los clientes (/api/leads, /api/leads.csv, /api/resumen). Mínimo 16 caracteres.
ADMIN_TOKEN=cambiar-por-un-token-largo-y-secreto
# Sitios que pueden guardar datos (separados por coma).
ALLOWED_ORIGINS=http://localhost:5173,https://uniformesm.onrender.com
